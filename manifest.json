{
	"manifest_version": 3,
	"name": "Vaulton Password Manager",
	"version": "1.0",
	"description": "Vaulton Password Manager Extension",
	"permissions": ["storage"],
	"host_permissions": ["http://localhost:4200/*"],
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"action": {
		"default_popup": "src/popup.html",
		"default_icon": {
			"16": "icons/icon.png",
			"48": "icons/icon.png",
			"128": "icons/icon.png"
		}
	},
	"icons": {
		"16": "icons/icon.png",
		"48": "icons/icon.png",
		"128": "icons/icon.png"
	}
}
